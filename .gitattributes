# Keep LF for files executed/parsed on Linux, even when cloned on Windows (core.autocrlf=true).
# CRLF in backup.sh would break the backup Job ("bad interpreter" / "$'\r': command not found").
* text=auto
*.sh   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
*.ps1  text eol=crlf
*.png  binary
*.jpg  binary
*.ico  binary
