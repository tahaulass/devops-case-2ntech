# Copy to .env (git-ignored) and change the values. Used only by docker-compose.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-locally
# Optional: raises the GitHub API rate limit from 60 to 5000 req/h.
GITHUB_TOKEN=
GITHUB_REPOS=kubernetes/kubernetes,facebook/react,mongodb/mongo,expressjs/express,python/cpython
